{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonshadow.local/coordination/task.schema.json",
  "title": "Moonshadow Work Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "task_id", "correlation_id", "title", "owner", "state",
    "scope", "inputs", "expected_output", "acceptance_tests", "evidence",
    "cost", "permission_level", "rollback", "blocker", "next_action",
    "retry_count", "updated_at"
  ],
  "properties": {
    "schema": { "const": "moonshadow.coordination.task.v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "owner": { "enum": ["allie", "amber", "cassandra", "josh"] },
    "state": { "enum": ["queued", "active", "blocked", "awaiting_josh", "verifying", "passed", "failed"] },
    "scope": { "type": "string", "minLength": 1 },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "expected_output": { "type": "string", "minLength": 1 },
    "acceptance_tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "cost": { "type": "object", "additionalProperties": false, "required": ["maximum_usd", "actual_usd"], "properties": { "maximum_usd": { "type": "number", "minimum": 0 }, "actual_usd": { "type": "number", "minimum": 0 } } },
    "permission_level": { "enum": ["read_only", "branch_write", "external_write", "josh_approval_required"] },
    "rollback": { "type": "string", "minLength": 1 },
    "blocker": { "type": ["string", "null"] },
    "next_action": { "type": "string", "minLength": 1 },
    "retry_count": { "type": "integer", "minimum": 0, "maximum": 2 },
    "manual_step": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["objective", "success_signal", "screenshot_clue"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "success_signal": { "type": "string", "minLength": 1 },
        "screenshot_clue": { "type": "string", "minLength": 1 }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}

